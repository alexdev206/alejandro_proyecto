# ==============================================================
# VARIABLES DE ENTORNO - APLICATIVO SISVAN & CONSULTAS PAI / ADRES
# ==============================================================

# 1. Clave de API de Google Gemini (requerida para escanear y leer documentos PDF e imágenes con IA)
# Obtén tu clave gratuita en: https://aistudio.google.com
GEMINI_API_KEY=

# 2. Dirección de escucha del servidor local (HOST)
# - 127.0.0.1 : Escucha solo en tu propio computador (modo seguro, por defecto).
# - 0.0.0.0   : Permite que otros computadores de tu red local puedan entrar a la app.
HOST=127.0.0.1
PORT=3000

# 3. Usuarios autorizados (AUTH_USERS)
# Puedes configurarlo de cualquiera de estas formas según tu preferencia:
#
# Opción A (La más sencilla - usuario:contraseña):
# AUTH_USERS="sneyder:MiClave2026, operador:Clave123"
#
# Opción B (Solo nombre de usuario - la clave será igual al usuario):
# AUTH_USERS="alex123"
#
# Opción C (Formato JSON avanzado con nombres y roles):
# AUTH_USERS='[{"username":"admin","name":"Administrador SISVAN","role":"admin","password":"TuPassword123"},{"username":"operador","name":"Operador de Turno","role":"usuario","password":"TuPassword456"}]'
#
# (Si dejas AUTH_USERS vacío, el aplicativo incluye por defecto: usuario "admin" / clave "admin26", o "usuario" / clave "usuario26")
AUTH_USERS="alex123:alex123"

